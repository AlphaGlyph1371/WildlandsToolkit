<Project>
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Product>Wildlands Toolkit</Product>
    <Authors>AlphaGlyph1371</Authors>

    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>

    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- The solution builds x64 while a single project builds AnyCPU. Without
         this the platform lands in the output path, so the two write to
         different folders and one of them quietly goes stale. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>
</Project>
