<Window x:Class="Wildlands.Toolkit.InstallModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How should this be installed?" Width="720" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="OptionCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FF2C2C33"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{StaticResource Accent}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Padding" Value="17,15"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="22,18">
            <StackPanel>
                <TextBlock Text="How should this be installed?" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextDim}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="22,18,22,0">
            <RadioButton x:Name="AddonOption" Style="{StaticResource OptionCard}" IsChecked="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="As addon" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Background="#FF1E3A57" BorderBrush="{StaticResource Accent}"
                                BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"/>
                        </Border>
                        <TextBlock x:Name="AddonSizeText" Foreground="{StaticResource TextDim}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                               Text="Writes a new archive beside the game files containing the changed resources. Existing archives stay untouched, no backup is needed, and uninstalling means deleting the new archive."/>
                    <TextBlock x:Name="AddonTargetText" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <TextBlock x:Name="AddonBlockedText" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Warning}" Visibility="Collapsed"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="InPlaceOption" Style="{StaticResource OptionCard}">
                <StackPanel>
                    <TextBlock Text="In place" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                               Text="Rewrites the game archives themselves. A backup of every archive is made first, which needs a lot of disk space and time, and two mods that change the same container cannot both be installed this way."/>
                    <TextBlock x:Name="InPlaceSizeText" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDim}" FontSize="11"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="22,14" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Padding="16,6" Margin="0,0,10,0"
                        IsCancel="True"/>
                <Button x:Name="ConfirmButton" Content="Install" Click="Confirm_Click"
                        Padding="18,6" IsDefault="True"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
