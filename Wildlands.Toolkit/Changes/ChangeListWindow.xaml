<Window x:Class="Wildlands.Toolkit.ChangeListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changes" Width="820" Height="520"
        MinWidth="720" MinHeight="360"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Cursor="Hand">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,13">
            <StackPanel>
                <TextBlock x:Name="CountText" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="DescriptionText"
                           Text="Nothing is written to the game until you click Apply changes."
                           Foreground="{StaticResource TextDim}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ListView x:Name="OperationList" SelectionMode="Extended"
                      SelectionChanged="OperationList_SelectionChanged"
                      MouseDoubleClick="OperationList_MouseDoubleClick"
                      KeyDown="OperationList_KeyDown"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Change" Width="330" DisplayMemberBinding="{Binding Label}"/>
                        <GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="Affected item" Width="220" DisplayMemberBinding="{Binding Target}"/>
                        <GridViewColumn Header="Archive" Width="140" DisplayMemberBinding="{Binding Archive}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="No changes are queued."
                       Foreground="{StaticResource TextDim}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RemoveButton" Content="Remove selected"
                            Click="Remove_Click" IsEnabled="False"/>
                    <Button x:Name="RemoveAllButton" Content="Remove all pending"
                            Click="RemoveAll_Click" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyButton" Content="Apply changes"
                            Click="Apply_Click" IsEnabled="False"
                            ToolTip="Write every pending change to the game archives"/>
                    <Button Content="Close" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
