<Window x:Class="Wildlands.Toolkit.IndexSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wildlands Toolkit — Prepare indexes" Height="430" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Prepare the Toolkit for your game" FontSize="19" FontWeight="SemiBold"
                   Foreground="{StaticResource Text}"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,18" TextWrapping="Wrap"
                   Foreground="{StaticResource TextDim}"
                   Text="The Toolkit keeps small local indexes of your installed game files. They make common features fast and avoid a full archive scan whenever you open an editor."/>

        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="1. Armory index" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="ArmoryText" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDim}"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="4" Padding="14">
                <StackPanel>
                    <TextBlock Text="2. Skeleton index" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="SkeletonText" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDim}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Not now" Click="Later_Click"/>
            <Button x:Name="PrepareButton" Content="Prepare Toolkit" Click="Prepare_Click" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
