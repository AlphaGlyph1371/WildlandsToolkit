<Window x:Class="Wildlands.Toolkit.AddAttachmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add attachment" Width="1080" Height="720" MinWidth="860" MinHeight="620"
        Background="{StaticResource Background}" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" UseLayoutRounding="True">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,11">
            <DockPanel LastChildFill="False">
                <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add attachment"
                        Click="Review_Click" Visibility="Collapsed"/>
                <Button x:Name="NextButton" DockPanel.Dock="Right" Content="Next: materials"
                        Click="Next_Click" IsDefault="True"/>
                <Button x:Name="BackButton" DockPanel.Dock="Right" Content="Back"
                        Click="Back_Click" Visibility="Collapsed"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextDim}"
                           Text="1  Basics and model     2  Materials and preview"/>
            </DockPanel>
        </Border>

        <Grid>
        <ScrollViewer x:Name="BasicsPage" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,22">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock x:Name="SlotText" Margin="0,4,0,18" Foreground="{StaticResource TextDim}"/>

                <TextBlock Text="Name shown in game *" Foreground="{StaticResource Text}"/>
                <TextBox x:Name="DisplayNameBox" Margin="0,5,0,14" MaxLength="100"/>

                <TextBlock Text="Internal name *" Foreground="{StaticResource Text}"/>
                <TextBox x:Name="InternalNameBox" Margin="0,5,0,14" MaxLength="100"
                         ToolTip="A unique technical name, for example MY_ATTACHMENT_ASR"/>

                <TextBlock Text="Gameplay template *" Foreground="{StaticResource Text}"/>
                <ComboBox x:Name="TemplateBox" Margin="0,5,0,4" DisplayMemberPath="DisplayName"/>
                <TextBlock Margin="0,0,0,18" Foreground="{StaticResource TextDim}" FontSize="10"
                           TextWrapping="Wrap"
                           Text="Copies the attachment's slot behavior, stats and base materials. It does not restrict which geometry you can import."/>

                <TextBlock Text="Model source *" Foreground="{StaticResource Text}"/>
                    <StackPanel Margin="0,5,0,0">
                        <RadioButton x:Name="ExistingAssetMode" Content="Use an existing game asset" IsChecked="True"
                                 Checked="ModelMode_Changed"/>
                        <TextBox x:Name="ExistingAssetBox" Margin="22,5,0,8"
                             ToolTip="Enter the existing game asset name or ID"/>

                        <RadioButton x:Name="ImportModelMode" Content="Import a model file"
                                 Checked="ModelMode_Changed"/>
                        <Grid Margin="22,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModelPathBox" IsEnabled="False" IsReadOnly="True"/>
                            <Button x:Name="BrowseModelButton" Grid.Column="1" Content="Browse…" Click="BrowseModel_Click"
                                IsEnabled="False" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock x:Name="ModelImportInfo" Margin="22,4,0,16"
                               Foreground="{StaticResource TextDim}" FontSize="10" TextWrapping="Wrap"
                               Text="Supported: glTF (.glb, .gltf) and OBJ (.obj). Foreign or missing skeletons are rebound automatically to the attachment."/>
                    </StackPanel>
                </StackPanel>
        </ScrollViewer>

        <Grid x:Name="MaterialsPage" Visibility="Collapsed" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Border x:Name="PreviewStage" Background="#FF111317" ClipToBounds="True"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                        MouseLeftButtonDown="Preview_MouseDown" MouseRightButtonDown="Preview_MouseDown"
                        MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp"
                        MouseRightButtonUp="Preview_MouseUp" MouseWheel="Preview_MouseWheel">
                    <Viewport3D x:Name="PreviewViewport">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="PreviewCamera" FieldOfView="45" UpDirection="0,0,1"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D x:Name="PreviewScene"/>
                    </Viewport3D>
                </Border>
                <DockPanel VerticalAlignment="Top" Margin="10">
                    <Button DockPanel.Dock="Left" Content="Fit" Click="PreviewFit_Click"/>
                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center"
                               Text="Drag to turn · right-drag to move · wheel to zoom"/>
                </DockPanel>
                <Border VerticalAlignment="Bottom" Background="#CC17191D" Padding="10,7">
                    <TextBlock x:Name="PreviewStatus" Foreground="{StaticResource TextDim}"
                               FontFamily="Consolas" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TextureOptionsPanel">
                    <TextBlock Text="Materials" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock Margin="0,4,0,16" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap"
                               Text="Optional texture maps for the new attachment. Empty slots keep the gameplay template's texture. Matching DDS compression and mip levels are copied without recompression; other images are encoded for Wildlands. The viewport previews Diffuse only."/>

                    <TextBlock Text="Diffuse / base colour" Foreground="{StaticResource Text}"/>
                    <DockPanel Margin="0,5,0,4">
                        <Button DockPanel.Dock="Right" Content="Clear" Tag="Diffuse" Click="ClearTexture_Click"/>
                        <Button DockPanel.Dock="Right" Content="Browse…" Tag="Diffuse" Click="BrowseTexture_Click"/>
                        <TextBox x:Name="DiffusePathBox" IsReadOnly="True"/>
                    </DockPanel>
                    <Border Height="78" Background="#FF111317" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" Margin="0,0,0,14">
                        <Image x:Name="DiffuseThumbnail" Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="Normal map" Foreground="{StaticResource Text}"/>
                    <DockPanel Margin="0,5,0,4">
                        <Button DockPanel.Dock="Right" Content="Clear" Tag="Normal" Click="ClearTexture_Click"/>
                        <Button DockPanel.Dock="Right" Content="Browse…" Tag="Normal" Click="BrowseTexture_Click"/>
                        <TextBox x:Name="NormalPathBox" IsReadOnly="True"/>
                    </DockPanel>
                    <Border Height="64" Background="#FF111317" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" Margin="0,0,0,14">
                        <Image x:Name="NormalThumbnail" Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="Specular map" Foreground="{StaticResource Text}"/>
                    <DockPanel Margin="0,5,0,4">
                        <Button DockPanel.Dock="Right" Content="Clear" Tag="Specular" Click="ClearTexture_Click"/>
                        <Button DockPanel.Dock="Right" Content="Browse…" Tag="Specular" Click="BrowseTexture_Click"/>
                        <TextBox x:Name="SpecularPathBox" IsReadOnly="True"/>
                    </DockPanel>
                    <Border Height="64" Background="#FF111317" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" Margin="0,0,0,14">
                        <Image x:Name="SpecularThumbnail" Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="Mask 1 / material mask" Foreground="{StaticResource Text}"/>
                    <DockPanel Margin="0,5,0,4">
                        <Button DockPanel.Dock="Right" Content="Clear" Tag="Mask1" Click="ClearTexture_Click"/>
                        <Button DockPanel.Dock="Right" Content="Browse…" Tag="Mask1" Click="BrowseTexture_Click"/>
                        <TextBox x:Name="Mask1PathBox" IsReadOnly="True"/>
                    </DockPanel>
                    <Border Height="64" Background="#FF111317" BorderBrush="{StaticResource Border}"
                            BorderThickness="1">
                        <Image x:Name="Mask1Thumbnail" Stretch="Uniform"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
