<Window x:Class="Wildlands.Toolkit.ClothBonePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Which bone?" Width="380" Height="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                   Margin="0,0,0,10"
                   Text="Every bone of the skeleton that this cloth is not already hanging on. They only have hashes, no names."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,5" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Add" Click="Confirm_Click" Padding="24,5" IsDefault="True"/>
        </StackPanel>
        <ListBox x:Name="List" Background="Transparent" BorderBrush="{StaticResource Border}"
                 BorderThickness="1" FontFamily="Consolas"/>
    </DockPanel>
</Window>
