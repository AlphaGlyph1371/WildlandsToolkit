<Window x:Class="Wildlands.Toolkit.MeshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesh" Height="760" Width="1040"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Fit" Click="Fit_Click" ToolTip="Frame the whole mesh"/>
                    <ToggleButton x:Name="ColourButton" Content="Ranges" Click="Colour_Click" IsChecked="True"
                                  Style="{StaticResource StateToggle}"
                                  ToolTip="A draw range is one material of the model. Colouring them apart shows where the model changes material - with textures on, only ranges without a texture are tinted."/>
                    <ToggleButton x:Name="TextureButton" Content="Textures" Click="Texture_Click"
                                  Style="{StaticResource StateToggle}"
                                  ToolTip="Follow each draw range to its material and texture set, and paint the diffuse texture the game uses"/>
                    <Button x:Name="BackfaceButton" Content="Back faces: as material" Click="Backface_Click"
                            ToolTip="Draw the far side of every surface as well, a shade darker, so a hole in the geometry still reads as a hole. The material decides unless it is forced here."/>
                    <Button x:Name="SkeletonButton" Content="Skeleton" Click="Skeleton_Click"
                            ToolTip="Override the skeleton the export picks by itself"/>
                    <Button Content="Export..." Click="Export_Click" ToolTip="Write this mesh as FBX or OBJ"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right" x:Name="HintText" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" FontSize="11"
                           Text="Drag to turn  ·  right-drag to move  ·  wheel to zoom"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{StaticResource TextDim}"
                           FontFamily="Consolas" FontSize="12"/>
                <TextBlock x:Name="SizeText" Grid.Column="1" Foreground="{StaticResource TextDim}"
                           FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>

        <Border x:Name="Stage" Background="#FF141416" ClipToBounds="True"
                MouseLeftButtonDown="Stage_MouseDown"
                MouseRightButtonDown="Stage_MouseDown"
                MouseMove="Stage_MouseMove"
                MouseLeftButtonUp="Stage_MouseUp"
                MouseRightButtonUp="Stage_MouseUp"
                MouseWheel="Stage_MouseWheel">
            <Viewport3D x:Name="Viewport">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="Camera" FieldOfView="45" UpDirection="0,0,1"/>
                </Viewport3D.Camera>
                <ModelVisual3D x:Name="Scene"/>
            </Viewport3D>
        </Border>
    </DockPanel>
</Window>
