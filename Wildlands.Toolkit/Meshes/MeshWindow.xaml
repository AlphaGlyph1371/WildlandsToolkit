<Window x:Class="Wildlands.Toolkit.MeshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesh" Height="800" Width="1180" MinHeight="560" MinWidth="820"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="MeshNameText" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MeshTypeText" Margin="0,2,0,0" FontSize="11"
                                   Foreground="{StaticResource TextDim}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ImportButton" Content="Replace mesh…"
                                Click="Replace_Click"
                                ToolTip="Replace this mesh from GLB, glTF or OBJ and queue it for Apply changes (Ctrl+R)"/>
                        <Button Content="Export…" Click="Export_Click" Margin="0"
                                ToolTip="Export the current viewer mesh as GLB, FBX or OBJ"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource Border}" Margin="0,10,0,9"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VIEW" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDisabled}" Margin="1,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Frame all" Click="Fit_Click"
                                    ToolTip="Frame the whole mesh (F)"/>
                            <ToggleButton x:Name="HierarchyButton" Content="Hierarchy"
                                          Click="Hierarchy_Click" IsChecked="True"
                                          Style="{StaticResource StateToggle}"
                                          ToolTip="Show or hide the scene hierarchy"/>
                            <ToggleButton x:Name="TextureButton" Content="Textures"
                                          Click="Texture_Click" IsChecked="True" Style="{StaticResource StateToggle}"
                                          ToolTip="Render every draw range with its full material: albedo, normal and detail maps, gloss and the game's clothing shader"/>
                            <ToggleButton x:Name="ColourButton" Content="Draw ranges"
                                          Click="Colour_Click" IsChecked="True"
                                          Style="{StaticResource StateToggle}"
                                          ToolTip="Tint separate material draw ranges when no texture is being shown"/>
                            <ToggleButton x:Name="FloorButton" Content="Floor"
                                          Click="Floor_Click" IsChecked="True"
                                          Style="{StaticResource StateToggle}"
                                          ToolTip="Show a floor that catches the shadow of the key light"/>
                            <ToggleButton x:Name="ChangesButton" Content="Pending changes"
                                          Click="Changes_Click" IsChecked="True" Visibility="Collapsed"
                                          Style="{StaticResource StateToggle}"
                                          ToolTip="Include queued changes to this mesh, its materials and textures. Turn off to see the game files for a before and after comparison; nothing is written either way"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{StaticResource Border}"
                            Margin="8,0,14,0"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GEOMETRY" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDisabled}" Margin="1,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="LodBox" Width="92" Margin="0,0,6,0" Visibility="Collapsed"
                                      SelectionChanged="Lod_Changed"
                                      ToolTip="Level of detail; LOD 0 is the full quality model the game shows up close"/>
                            <ComboBox x:Name="BackfaceBox" Width="166" SelectedIndex="0"
                                      SelectionChanged="Backface_Changed"
                                      ToolTip="Choose whether the reverse side of a surface is rendered">
                                <ComboBoxItem Content="Back faces: material"/>
                                <ComboBoxItem Content="Back faces: always"/>
                                <ComboBoxItem Content="Back faces: never"/>
                            </ComboBox>
                            <Button x:Name="SkeletonButton" Content="Choose skeleton…"
                                    Click="Skeleton_Click" Margin="6,0,0,0"
                                    ToolTip="Override the skeleton used when exporting GLB or FBX"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="3" x:Name="StyleSeparator" Width="1" Background="{StaticResource Border}"
                            Margin="14,0,14,0" Visibility="Collapsed"/>

                    <StackPanel Grid.Column="4" x:Name="StylePanel" Visibility="Collapsed">
                        <TextBlock Text="STYLE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDisabled}" Margin="1,0,0,4"/>
                        <ComboBox x:Name="StyleBox" Width="240" IsEnabled="False"
                                  SelectionChanged="Style_Changed"
                                  ToolTip="Show the clothing the way the game paints it for the chosen customization style"/>
                    </StackPanel>

                    <TextBlock Grid.Column="6" x:Name="HintText" VerticalAlignment="Bottom"
                               Foreground="{StaticResource TextDim}" FontSize="11" Margin="20,0,0,6"
                               TextWrapping="Wrap" MaxWidth="260"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="PendingBadge" Grid.Column="0" Visibility="Collapsed"
                        Background="{StaticResource Accent}" CornerRadius="3" Padding="6,2"
                        Margin="0,0,9,0">
                    <TextBlock Text="PENDING APPLY" Foreground="#FF10161E"
                               FontSize="10" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource TextDim}"
                           FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SizeText" Grid.Column="2" Foreground="{StaticResource TextDim}"
                           FontFamily="Consolas" FontSize="12" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HierarchyColumn" Width="300"/>
                <ColumnDefinition x:Name="HierarchySplitterColumn" Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="HierarchyPanel" Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource Border}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="HIERARCHY" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDisabled}"/>
                    </Border>

                    <TreeView x:Name="HierarchyTree" BorderThickness="0" Padding="5"
                              Background="{StaticResource Surface}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="Hierarchy_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid Margin="1,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsThreeState="True"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              Tag="{Binding}" Click="HierarchyVisibility_Click"
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" MaxWidth="235"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10"
                                                   Foreground="{StaticResource TextDim}"
                                                   TextWrapping="Wrap" MaxWidth="235"
                                                   ToolTip="{Binding Detail}"/>
                                    </StackPanel>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="HierarchySplitter" Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"/>

            <Border Grid.Column="2" x:Name="Stage" Background="#FF141416" ClipToBounds="True"
                    SizeChanged="Stage_SizeChanged">
                <Image x:Name="Picture" Stretch="Fill"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
