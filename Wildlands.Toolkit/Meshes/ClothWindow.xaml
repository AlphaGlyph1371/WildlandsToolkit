<Window x:Class="Wildlands.Toolkit.ClothWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloth" Height="820" Width="1120" MinHeight="620" MinWidth="900"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="NameText" FontSize="17" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                           Text="This holds how one piece of clothing swings and hangs. What each single number means is not worked out yet, so the moves that pay off are copying a behaviour that already works somewhere else and changing which bones the cloth follows."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Width="110"
                        Click="Save_Click" IsEnabled="False" FontWeight="SemiBold"
                        ToolTip="Put the changed settings on the change list"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="TAKE A BEHAVIOUR FROM SOMEWHERE ELSE" FontWeight="SemiBold"
                               FontSize="11"/>
                    <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap"
                               Text="Open a garment that already moves the way you want, save its settings, then load them here. The bones stay as they are unless you tick the box."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save these settings to a file…" Click="ExportSettings_Click"
                                Padding="14,6"/>
                        <Button Content="Load settings from a file…" Click="ImportSettings_Click"
                                Margin="8,0,0,0" Padding="14,6"/>
                    </StackPanel>
                    <CheckBox x:Name="WithBonesBox" Margin="0,8,0,0"
                              Content="Take the bone list along as well"/>

                    <Border Height="1" Background="{StaticResource Border}" Margin="0,16"/>

                    <TextBlock Text="PUT IT BACK" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock x:Name="DiffText" Margin="0,4,0,8" FontSize="11"
                               Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                    <Button x:Name="DefaultsButton" Content="Set every value to what most garments use"
                            Click="Defaults_Click" Padding="14,6" HorizontalAlignment="Left"/>

                    <Border Height="1" Background="{StaticResource Border}" Margin="0,16"/>

                    <TextBlock Text="BONES THE CLOTH HANGS ON" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap"
                               Text="Pick one to light it up on the right. Take a bone out and the cloth stops following it."/>
                    <ListBox x:Name="BoneList" Height="170" Background="Transparent"
                             BorderBrush="{StaticResource Border}" BorderThickness="1"
                             SelectionChanged="Bone_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RemoveBoneButton" Content="Take this one out"
                                Click="RemoveBone_Click" Padding="14,5" IsEnabled="False"/>
                        <Button x:Name="AddBoneButton" Content="Add a bone…" Click="AddBone_Click"
                                Margin="8,0,0,0" Padding="14,5"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource Border}" Margin="0,16"/>

                    <Expander x:Name="RawExpander" Header="Show the raw values"
                              Expanded="Raw_Toggled" Collapsed="Raw_Toggled">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,0,0,8" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource Warning}"
                                       Text="What these do is unknown. They are named after where they sit in the file. Changing one is an experiment: alter a single value, install, and look at it in the game."/>
                            <CheckBox x:Name="AllFieldsBox" Content="Also show the ones no garment ever changes"
                                      Click="AllFields_Click" Margin="0,0,0,8"/>
                            <ListView x:Name="FieldList" Height="260" Background="Transparent"
                                      BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Where in the file" Width="140"
                                                        DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="This garment" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent"
                                                             Padding="0" Margin="-4,0"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Rest of the game" Width="180"
                                                        DisplayMemberBinding="{Binding Note}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                        <TextBlock Text="WHERE IT HANGS" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock x:Name="BoneHint" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid x:Name="Stage" Background="#FF14141A" ClipToBounds="True" Margin="16,0,16,16">
                        <Viewport3D x:Name="Viewport">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="Camera" FieldOfView="45"
                                                   UpDirection="0,0,1"/>
                            </Viewport3D.Camera>
                            <ModelVisual3D x:Name="Scene"/>
                        </Viewport3D>
                        <TextBlock x:Name="NoSkeletonText" Margin="20" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextAlignment="Center" Foreground="{StaticResource TextDisabled}"
                                   Visibility="Collapsed"
                                   Text="No skeleton was found for these bones. Build the skeleton index in the main window and open this again to see them."/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
