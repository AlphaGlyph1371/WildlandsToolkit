<Window x:Class="Wildlands.Toolkit.ClothWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloth" Height="800" Width="1180" MinHeight="600" MinWidth="900"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DetailText" Margin="0,2,0,0" FontSize="11"
                           Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Width="96"
                        Click="Save_Click" IsEnabled="False"
                        ToolTip="Put the edited settings on the change list"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Padding="14,12,14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SETTINGS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDisabled}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AllFieldsBox" Content="Show the fields no garment changes"
                                  Margin="14,0,0,0" Click="AllFields_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ListView x:Name="FieldList" Margin="14,0,14,14" Background="Transparent"
                          BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Field" Width="150"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Value" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"
                                                 Padding="0" Margin="-4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Across the game" Width="190"
                                            DisplayMemberBinding="{Binding Note}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <Border Grid.Column="1" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12,14,6">
                        <StackPanel>
                            <TextBlock Text="BONES THIS CLOTH HANGS ON" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextDisabled}"/>
                            <TextBlock x:Name="BoneHint" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="14,6,14,14">
                        <ListBox x:Name="BoneList" Height="150" Background="Transparent"
                                 BorderBrush="{StaticResource Border}" BorderThickness="1"
                                 SelectionChanged="Bone_Changed"/>
                    </Border>
                    <Grid x:Name="Stage" Background="#FF14141A" ClipToBounds="True" Margin="14,0">
                        <Viewport3D x:Name="Viewport">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="Camera" FieldOfView="45"
                                                   UpDirection="0,0,1"/>
                            </Viewport3D.Camera>
                            <ModelVisual3D x:Name="Scene"/>
                        </Viewport3D>
                        <TextBlock x:Name="NoSkeletonText" Margin="16" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextAlignment="Center" Foreground="{StaticResource TextDisabled}"
                                   Visibility="Collapsed"
                                   Text="No skeleton was found for these bones. Build the skeleton index in the main window to see them."/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
