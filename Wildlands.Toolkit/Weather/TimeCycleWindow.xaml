<Window x:Class="Wildlands.Toolkit.TimeCycleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time cycle" Height="780" Width="1120"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="Save" Click="Save_Click" IsEnabled="False"
                            ToolTip="Hand the edited cycle to the change list. Apply in the main window writes it."/>
                    <Button x:Name="RevertButton" Content="Revert all" Click="Revert_Click" IsEnabled="False"
                            ToolTip="Throw the edits away and go back to what the game shipped"/>
                    <Button Content="Export as text" Click="Export_Click"
                            ToolTip="Write the whole cycle out in the same form wlcli timecycle uses"/>
                    <Button Content="[DEV] Apply graphics profile" Click="ApplyProfile_Click"
                            ToolTip="Preview an external JSON profile on this exact controller"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Filter" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}" Margin="12,0,6,0"/>
                    <TextBox x:Name="FilterBox" Width="220" TextChanged="Filter_Changed"
                             ToolTip="Show only entries whose path contains this text"/>
                    <ToggleButton x:Name="VaryingToggle" Content="Only curves" Click="Filter_Changed"
                                  Style="{StaticResource StateToggle}" Margin="6,0,0,0"
                                  ToolTip="Hide the entries that hold the same value all day"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" x:Name="EntryList" BorderThickness="0"
                      SelectionChanged="Entry_Changed">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="20">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mark}" Foreground="{StaticResource Accent}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Index}"/>
                        <GridViewColumn Header="Property" Width="290" DisplayMemberBinding="{Binding Path}"/>
                        <GridViewColumn Header="Over the day" Width="100"
                                        DisplayMemberBinding="{Binding Summary}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

            <DockPanel Grid.Column="2" Margin="12,10,12,10">
                <TextBlock DockPanel.Dock="Top" x:Name="EntryTitle" Text="Nothing selected"
                           Foreground="{StaticResource Text}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock DockPanel.Dock="Top" x:Name="EntryNote" Margin="0,4,0,10"
                           Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AddKeyButton" Content="Add key" Click="AddKey_Click" IsEnabled="False"/>
                    <Button x:Name="RemoveKeyButton" Content="Remove key" Click="RemoveKey_Click" IsEnabled="False"/>
                </StackPanel>

                <ListView x:Name="KeyList" BorderThickness="1"
                          BorderBrush="{StaticResource Border}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time of day" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding TimeFixed}"
                                                 LostFocus="Key_Committed" Width="100"
                                                 ToolTip="hh:mm:ss. The first key is midnight and cannot move."/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Value" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 LostFocus="Key_Committed" Width="280"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="40" Height="16" CornerRadius="2"
                                                Background="{Binding Swatch}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                Visibility="{Binding SwatchShown}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
