<Window x:Class="Wildlands.Toolkit.SkyLayerPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy from which layer?" Width="360" Height="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                   Margin="0,0,0,10"
                   Text="The texels of the layer you pick overwrite the one you are editing."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,5" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Copy" Click="Confirm_Click" Padding="20,5" IsDefault="True"/>
        </StackPanel>
        <ListBox x:Name="List" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Image Source="{Binding Thumbnail}" Width="32" Height="64"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
