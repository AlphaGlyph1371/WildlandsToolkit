<Window x:Class="Wildlands.Toolkit.SkeletonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skeleton" Height="800" Width="1080" MinHeight="560" MinWidth="760"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="SkeletonNameText" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SkeletonTypeText" Margin="0,2,0,0" FontSize="11"
                                   Foreground="{StaticResource TextDim}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ImportButton" Content="Import edited skeleton…"
                                Click="Import_Click"
                                ToolTip="Import a GLB edited in Blender and queue it for Apply changes"/>
                        <Button Content="Export…" Click="Export_Click" Margin="0"
                                ToolTip="Export this skeleton as a Blender-readable GLB"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource Border}" Margin="0,10,0,9"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VIEW" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDisabled}" Margin="1,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Frame all" Click="Fit_Click"
                                    ToolTip="Frame the whole skeleton (F)"/>
                            <ToggleButton x:Name="AxesButton" Content="Bone axes"
                                          IsChecked="True" Click="Axes_Click"
                                          Style="{StaticResource StateToggle}"
                                          ToolTip="Show each bone's local X, Y and Z axes"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="2" VerticalAlignment="Bottom"
                               Foreground="{StaticResource TextDim}" FontSize="11" Margin="20,0,0,6"
                               Text="Left-drag orbit  ·  right-drag pan  ·  wheel zoom  ·  F frame"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="PendingBadge" Grid.Column="0" Visibility="Collapsed"
                        Background="{StaticResource Accent}" CornerRadius="3" Padding="6,2"
                        Margin="0,0,9,0">
                    <TextBlock Text="PENDING APPLY" Foreground="#FF10161E"
                               FontSize="10" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource TextDim}"
                           FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SizeText" Grid.Column="2" Foreground="{StaticResource TextDim}"
                           FontFamily="Consolas" FontSize="12" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <Border x:Name="Stage" Background="#FF141416" ClipToBounds="True">
            <Viewport3D x:Name="Viewport">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="Camera" FieldOfView="45" UpDirection="0,0,1"/>
                </Viewport3D.Camera>
                <ModelVisual3D x:Name="Scene"/>
            </Viewport3D>
        </Border>
    </DockPanel>
</Window>
