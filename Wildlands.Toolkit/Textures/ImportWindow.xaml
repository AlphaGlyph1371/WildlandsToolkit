<Window x:Class="Wildlands.Toolkit.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import texture" Height="560" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="17" Margin="0,0,0,4"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Row="1" x:Name="TargetText" Margin="0,0,0,16"
                   FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextDim}"/>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="File" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDim}"/>
            <TextBox Grid.Column="1" x:Name="PathBox" Margin="0,0,8,0" TextChanged="Path_Changed"/>
            <Button Grid.Column="2" Content="Browse" Click="Browse_Click" Margin="0"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="60,0,0,10">
            <CheckBox x:Name="GenerateMipsBox" Content="Generate mip levels" IsChecked="True"
                      Click="Options_Changed" VerticalAlignment="Center"
                      ToolTip="Off keeps the levels a dds already carries, which is lossless"/>
        </StackPanel>

        <Border Grid.Row="4" Margin="60,0,0,14" Padding="10,8" CornerRadius="3"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1">
            <TextBlock x:Name="SourceText" TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="12"/>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="3"
                    Background="#FF141416" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Image x:Name="Preview" Stretch="Uniform" Margin="6"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="Written into" Margin="0,0,0,6"
                           Foreground="{StaticResource TextDim}"/>
                <ListBox x:Name="TargetList" FontFamily="Consolas" FontSize="11"
                         Background="{StaticResource Surface}"
                         BorderBrush="{StaticResource Border}" BorderThickness="1"/>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="ImportButton" Content="Import" Click="Import_Click" Margin="0"
                    IsDefault="True" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
