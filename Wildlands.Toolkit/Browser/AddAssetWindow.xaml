<Window x:Class="Wildlands.Toolkit.AddAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add asset" Height="390" Width="620" MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>

        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Source" Foreground="{StaticResource TextDim}"/>
                <TextBlock x:Name="SourceText" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                <TextBlock Grid.Row="1" Text="Target" Foreground="{StaticResource TextDim}" Margin="0,5,0,0"/>
                <TextBlock x:Name="TargetText" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Name" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
            <TextBox x:Name="NameBox" Grid.Column="1" MaxLength="512"/>
            <TextBlock x:Name="IdLabel" Grid.Row="1" Text="ID" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,10,0,0"/>
            <TextBox x:Name="IdBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" FontFamily="Consolas" ToolTip="Unique ID for the new resource"/>
        </Grid>

        <Grid x:Name="TemplateRow" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Copy settings from" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
            <ComboBox x:Name="TemplateBox" Grid.Column="1">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <StackPanel x:Name="ErrorPanel" Grid.Row="4" Margin="110,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FFE46A6A" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button x:Name="AddButton" Content="Add to Changes" Click="Add_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
