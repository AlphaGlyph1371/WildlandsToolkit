<Window x:Class="Wildlands.Toolkit.AssetUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find asset copies" Height="520" Width="980" MinHeight="340" MinWidth="700"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,13">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="IdText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ListView x:Name="Results" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Archive" Width="180" DisplayMemberBinding="{Binding Archive}"/>
                        <GridViewColumn Header="Container" Width="270" DisplayMemberBinding="{Binding Container}"/>
                        <GridViewColumn Header="Resource" Width="280" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDim}" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="420" Margin="32" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,7">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Panel.ZIndex="10" Visibility="Collapsed" Background="#B8141416" Cursor="Wait" Focusable="True">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360" Padding="28,22" CornerRadius="6" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Finding asset copies" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingText" Margin="0,7,0,14" MaxWidth="480" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <ProgressBar Height="8" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="{StaticResource Background}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
