<Window x:Class="Wildlands.Toolkit.ModInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install mod package" Width="920" Height="620"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="22,18">
            <StackPanel>
                <TextBlock Text="Install mod package" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Review the package before installing it into the game."
                           Foreground="{StaticResource TextDim}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Name" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
            <TextBlock x:Name="NameText" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,18,8"/>
            <TextBlock Grid.Column="2" Text="Version" Foreground="{StaticResource TextDim}"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="VersionText" Grid.Column="3" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Text="Author" Foreground="{StaticResource TextDim}"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="AuthorText" Grid.Row="1" Grid.Column="1" Margin="0,0,18,8"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Package"
                       Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
            <TextBlock x:Name="PackageText" Grid.Row="1" Grid.Column="3"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Text="Contents" Foreground="{StaticResource TextDim}"/>
            <TextBlock x:Name="ContentsText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"/>
        </Grid>

        <Grid Grid.Row="2" Margin="22,0,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Changes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListView x:Name="ChangeList" Grid.Row="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Change" Width="330" DisplayMemberBinding="{Binding Label}"/>
                        <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding Kind}"/>
                        <GridViewColumn Header="Affected item" Width="230" DisplayMemberBinding="{Binding Target}"/>
                        <GridViewColumn Header="Archive" Width="160" DisplayMemberBinding="{Binding Archive}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Border Grid.Row="2" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="WorkspaceNotice" Foreground="#FFFFC857"
                               TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="Install prepares the package and then shows one final archive-write confirmation with backup and disk-space details. Confirming that step writes the mod into the game archives."
                               Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="14,11">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click"/>
                <Button Content="Install" Click="Install_Click" Margin="0"
                        Background="{StaticResource Accent}" Foreground="Black"
                        BorderBrush="{StaticResource Accent}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
