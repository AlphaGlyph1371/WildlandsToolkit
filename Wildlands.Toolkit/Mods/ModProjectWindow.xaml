<Window x:Class="Wildlands.Toolkit.ModProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New mod project" Height="350" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0" Text="Create a mod project" FontSize="20"
                   FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="DescriptionText" Grid.Row="1" Text="Changes made while this project is active are saved and can be built as a .wlmod package."
                   TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,18"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Name" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
            <TextBox x:Name="NameBox" Grid.Column="1" MaxLength="200"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Author" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
            <TextBox x:Name="AuthorBox" Grid.Column="1" Margin="0,0,12,0" MaxLength="200"/>
            <TextBlock Grid.Column="2" Text="Version" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDim}"/>
            <TextBox x:Name="VersionBox" Grid.Column="3" Text="1.0.0" MaxLength="100"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="4" VerticalAlignment="Bottom"
                   Foreground="#FFE46A6A" Margin="90,12,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Content="Choose project folder…" Click="Create_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
