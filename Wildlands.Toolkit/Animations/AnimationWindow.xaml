<Window x:Class="Wildlands.Toolkit.AnimationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animation" Height="820" Width="1080" MinHeight="560" MinWidth="760"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DetailText" Margin="0,2,0,0" FontSize="11"
                               Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Frame all" Click="Fit_Click" ToolTip="Frame the whole skeleton (F)"/>
                    <Button Content="Choose skeleton…" Click="Skeleton_Click" Margin="6,0,0,0"
                            ToolTip="Play this animation on a skeleton from another data file"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Grid.Column="0" Content="Pause" Width="74"
                        Click="Play_Click" ToolTip="Play or pause (Space)"/>
                <ComboBox x:Name="SpeedBox" Grid.Column="1" Width="96" Margin="6,0,10,0"
                          SelectedIndex="2" SelectionChanged="Speed_Changed">
                    <ComboBoxItem Content="0.1x"/>
                    <ComboBoxItem Content="0.5x"/>
                    <ComboBoxItem Content="1x"/>
                    <ComboBoxItem Content="2x"/>
                </ComboBox>
                <Slider x:Name="TimeSlider" Grid.Column="2" Minimum="0" Maximum="1"
                        VerticalAlignment="Center" IsMoveToPointEnabled="True"
                        ValueChanged="Time_Changed"/>
                <TextBlock x:Name="TimeText" Grid.Column="3" Margin="12,0,0,0" Width="132"
                           TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" FontSize="11"/>
            </Grid>
        </Border>

        <Grid x:Name="Stage" Background="#FF14141A" ClipToBounds="True">
            <Viewport3D x:Name="Viewport">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="Camera" FieldOfView="45" UpDirection="0,0,1"/>
                </Viewport3D.Camera>
                <ModelVisual3D x:Name="Scene"/>
            </Viewport3D>
            <TextBlock x:Name="HintText" Margin="14" VerticalAlignment="Bottom"
                       Foreground="{StaticResource TextDisabled}" FontSize="11"
                       Text="Drag to orbit, right-drag to pan, wheel to zoom"/>
        </Grid>
    </DockPanel>
</Window>
