<Window x:Class="Wildlands.Toolkit.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toolkit update available" Height="470" Width="660"
        MinHeight="380" MinWidth="540" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="A new Wildlands Toolkit version is available"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,6,0,0"
                       Foreground="{StaticResource TextDim}"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource Border}"
                Margin="0,18,0,14"/>

        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="4" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="WHAT'S NEW" FontSize="10"
                           FontWeight="SemiBold" Foreground="{StaticResource TextDisabled}"
                           Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDim}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="The download opens on the official GitHub release page."
                       Foreground="{StaticResource TextDim}" FontSize="11"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Later" Click="Later_Click"/>
                <Button Content="Open release page" Click="Open_Click" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
